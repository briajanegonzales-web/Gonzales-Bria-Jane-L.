# CHAPTER 5: CONDITIONAL STATEMENTS
print("\nCHAPTER 5: CONDITIONAL STATEMENTS")
print("A conditional statement lets a program make a decision.")

print("\n1. IF STATEMENT")
print("An if statement runs a block of code when its condition is True.")
print("Example:")
print("if 10 > 5:")
print("    print('Yes')")
print("Output: Yes")

print("\n2. IF-ELIF-ELSE STATEMENT")
print("if checks the first condition.")
print("elif checks another condition if the earlier condition is False.")
print("else runs when all previous conditions are False.")
print("Example:")
print("if  score >= 90: print('Excellent')")
print("elif score >= 75: print('Passed')")
print("else: print('Failed')")
print("Sample output for score = 85: Passed")

print("\n3. COMPARISON OPERATORS")
print("Comparison operators compare two values.")
print("== Equal to")
print("!= Not equal to")
print(">  Greater than")
print("<  Less than")
print(">= Greater than or equal to")
print("<= Less than or equal to")
print("Example: print(8 > 3)")
