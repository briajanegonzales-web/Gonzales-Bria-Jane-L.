print("\n4. LOGICAL OPERATORS")
print("Logical operators combine or change conditions.")
print("and is True when both conditions are True.")
print("or is True when at least one condition is True.")
print("not changes True to False or False to True.")
print("Example: print(5 > 2 and 8 > 3)")
print("Output: True")

print("\n5. NESTED IF")
print("A nested if is an if statement placed inside another if statement.")
print("Example:")
print("if 10 > 5:")
print("    if 8 > 3:")
print("        print('Both are true')")
print("Output: Both are true")

# CHAPTER 6: INTRODUCTION TO ITERATION AND LOOPS
print("\nCHAPTER 6: INTRODUCTION TO ITERATION AND LOOPS")
print("Iteration means repeating instructions in a program.")
print("A loop repeats code based on a sequence or condition.")

print("\n1. FOR LOOP")
print("A for loop repeats instructions for each value in a sequence.")
print("Example:")
print("for number in range(1, 4):")
print("    print(number)")
print("Output:")
print("1")
print("2")
print("3")

print("\n2. RANGE() FUNCTION")
print("range() creates a sequence of numbers.")
print("The ending number is not included.")
print("Example:")
print("for number in range(5, 0, -1):")
print("    print(number)")
print("Output:")
print("5")
print("4")
print("3")
print("2")
print("1")

print("\n3. WHILE LOOP")
print("A while loop repeats while its condition is True.")
print("Example:")
print("number = 1")
print("while number <= 3:")
print("    print(number)")
print("    number = number + 1")
print("Output:")
print("1")
print("2")
print("3")

